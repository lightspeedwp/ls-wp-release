{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm"],
  "labels": ["area:dependencies"],
  "automerge": false,
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Vitest and its V8 coverage provider must stay on the identical version",
      "matchPackageNames": ["vitest", "@vitest/coverage-v8"],
      "groupName": "vitest",
      "automerge": false
    }
  ]
}
